# Staging: API rodando no computador da equipe, na rede local.
# 192.168.24.7 = IP deste computador na rede (Ethernet); troque aqui se ele mudar.
# Funciona no emulador e no celular na mesma rede (libere a porta 8080 no firewall).
# É o ambiente padrão: `npm run apk` e o .env de desenvolvimento usam este.
EXPO_PUBLIC_API_URL=http://192.168.24.7:8080
