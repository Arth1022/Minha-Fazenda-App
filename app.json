{
  "expo": {
    "name": "Minha Fazenda",
    "slug": "minha-fazenda",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "minhafazenda",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.minhafazenda.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E8F5E9",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.SCHEDULE_EXACT_ALARM"],
      "package": "com.minhafazenda.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1B5E20",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "O Minha Fazenda usa a câmera para ler QR Codes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "O Minha Fazenda usa suas fotos para salvar os QR Codes.",
          "savePhotosPermission": "O Minha Fazenda salva os QR Codes na sua galeria.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "./plugins/withModeloOcr",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Minha Fazenda usa suas fotos para guardar a foto do animal e os comprovantes de vacina e exame.",
          "cameraPermission": "O Minha Fazenda usa a câmera para fotografar o animal e os comprovantes.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1B5E20"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
